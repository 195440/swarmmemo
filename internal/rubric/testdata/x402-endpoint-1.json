{
  "schema": "swarmmemo.rubric/1",
  "id": "x402-endpoint",
  "version": "1.0.0-draft.1",
  "title": "x402 endpoint (test copy; the served rubric is RFC 0019's)",
  "subject_types": ["x402"],
  "dimensions": [
    {"id": "works", "weight": 45},
    {"id": "as_described", "weight": 30},
    {"id": "safe", "weight": 15},
    {"id": "good", "weight": 10}
  ],
  "decay": {"free": 14, "paid": 30},
  "checks": [
    {"id": "R1", "dimension": "works", "weight": 15, "kind": "free", "metric": "rate", "on_revision": "half", "title": "Reachable"},
    {"id": "R2", "dimension": "works", "weight": 10, "kind": "free", "metric": "rate", "on_revision": "half", "title": "Unpaid request answers 402"},
    {"id": "R3", "dimension": "works", "weight": 5, "kind": "free", "metric": "curve", "on_revision": "half", "title": "Unpaid latency",
     "curve": {"input": "p95", "points": [[300, 100], [1000, 90], [3000, 50], [10000, 0]]}},
    {"id": "R4", "dimension": "works", "weight": 30, "kind": "paid", "metric": "rate", "on_revision": "half", "title": "Paid call succeeds"},
    {"id": "R5", "dimension": "works", "weight": 25, "kind": "paid", "metric": "rate", "on_revision": "half", "title": "Output valid"},
    {"id": "R7", "dimension": "works", "weight": 5, "kind": "paid", "metric": "curve", "on_revision": "half", "title": "Paid latency",
     "curve": {"input": "p95", "points": [[500, 100], [2000, 90], [6000, 50], [20000, 0]]}},
    {"id": "C1", "dimension": "works", "weight": 15, "kind": "free", "metric": "rate", "on_revision": "reset", "title": "PaymentRequired parses"},
    {"id": "C2", "dimension": "works", "weight": 12, "kind": "free", "metric": "rate", "on_revision": "reset", "title": "Requirements well-formed"},
    {"id": "C3", "dimension": "works", "weight": 8, "kind": "free", "metric": "rate", "on_revision": "reset", "title": "Asset real"},
    {"id": "C4", "dimension": "works", "weight": 3, "kind": "free", "metric": "rate", "on_revision": "reset", "title": "Header and body agree"},
    {"id": "C5", "dimension": "works", "weight": 8, "kind": "free", "metric": "rate", "on_revision": "reset", "title": "Discovery schema"},
    {"id": "C6", "dimension": "works", "weight": 5, "kind": "paid", "metric": "rate", "on_revision": "reset", "title": "Settlement response"},
    {"id": "H1", "dimension": "as_described", "weight": 20, "kind": "free", "metric": "rate", "on_revision": "half", "title": "Price as listed"},
    {"id": "H2", "dimension": "as_described", "weight": 10, "kind": "free", "metric": "rate", "on_revision": "half", "title": "Price stable"},
    {"id": "H3", "dimension": "as_described", "weight": 10, "kind": "free", "metric": "rate", "on_revision": "half", "title": "payTo stable"},
    {"id": "H4", "dimension": "as_described", "weight": 10, "kind": "free", "metric": "rate", "on_revision": "half", "title": "payTo matches the operator"},
    {"id": "H5", "dimension": "as_described", "weight": 15, "kind": "paid", "metric": "rate", "on_revision": "half", "title": "Charged the quote"},
    {"id": "H6", "dimension": "as_described", "weight": 20, "kind": "paid", "metric": "rate", "on_revision": "half", "title": "Paid the quoted payTo"},
    {"id": "H7", "dimension": "as_described", "weight": 15, "kind": "paid", "metric": "rate", "on_revision": "half", "title": "Charged once"},
    {"id": "H8", "dimension": "as_described", "weight": 0, "kind": "paid", "metric": "rate", "on_revision": "half", "title": "No charge without delivery (gate only)"},
    {"id": "S1", "dimension": "safe", "weight": 30, "kind": "free", "metric": "rate", "title": "Transport"},
    {"id": "S2", "dimension": "safe", "weight": 30, "kind": "free", "metric": "rate", "half_life_days": 30, "title": "Description and docs screen"},
    {"id": "S3", "dimension": "safe", "weight": 20, "kind": "paid", "metric": "rate", "title": "Output screen"},
    {"id": "S4", "dimension": "safe", "weight": 15, "kind": "free", "metric": "rate", "title": "No secret asks"},
    {"id": "S5", "dimension": "safe", "weight": 5, "kind": "free", "metric": "rate", "title": "Content type"},
    {"id": "R6", "dimension": "good", "weight": 100, "kind": "paid", "metric": "rate", "on_revision": "half", "title": "Output correct"}
  ],
  "gates": [
    {"flag": "charged_without_delivery", "check": "H8", "when": "fail_weight_gte", "value": 0.5, "clear_after_passes": 2, "cap": 59, "verdict": "avoid"},
    {"flag": "overcharge", "check": "H5", "when": "fail_weight_gte", "value": 0.25, "cap": 39, "verdict": "avoid"},
    {"flag": "wrong_payee", "check": "H6", "when": "fail_weight_gte", "value": 0.25, "cap": 39, "verdict": "avoid"},
    {"flag": "injection", "check": "S2", "when": "fail_weight_gte", "value": 0.5, "clear_after_passes": 1, "cap": 69, "verdict": "caution"},
    {"flag": "injection", "check": "S3", "when": "fail_weight_gte", "value": 0.5, "clear_after_passes": 1, "cap": 69, "verdict": "caution"},
    {"flag": "down", "check": "R1", "when": "failing_for_hours", "value": 72, "verdict": "down", "stale": true},
    {"flag": "payto_changed", "check": "H3", "when": "failed_within_hours", "value": 168, "verdict": "caution", "watch": true}
  ],
  "grades": [{"grade": "A", "min": 90}, {"grade": "B", "min": 80}, {"grade": "C", "min": 70}, {"grade": "D", "min": 60}, {"grade": "F", "min": 0}],
  "confidence": [{"level": "high", "max_width": 10}, {"level": "medium", "max_width": 25}, {"level": "low", "max_width": 100}],
  "verdict": {"probe_check": "R1", "min_probes": 8, "min_span_days": 3, "paid_within_days": 30,
              "avoid_grades": ["F"], "caution_grades": ["C", "D"], "caution_confidence": ["low"]},
  "outlook": {"recent_days": 14, "baseline_days": 30, "delta": 5},
  "watch": {"revision_days": 7},
  "monte_carlo": {"draws": 4000, "band": [10, 90]}
}
